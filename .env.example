# ---- NetEye environment template -------------------------------------------
# Copy to .env.local and adjust. NetEye shows real data only — without
# CLOUDFLARE_API_TOKEN the globe is empty and /api/health reports why.

# Port for the standalone WebSocket server (server/websocket.js)
WS_PORT=3001
# URL the browser uses to reach the WebSocket server
NEXT_PUBLIC_WS_URL=ws://localhost:3001


# ---- Data sources -----------------------------------------------------------
# Cloudflare Radar (outages, BGP hijacks/leaks, L3 DDoS shares). Create a free
# token with Account > Radar > Read. Without it NetEye shows no incidents.
CLOUDFLARE_API_TOKEN=
# Radar response cache TTL (ms)
RADAR_CACHE_TTL_MS=60000

# IODA (Georgia Tech) country-level outage detections. No key. On by default;
# set IODA_DISABLED=1 to switch the source off.
IODA_DISABLED=
IODA_CACHE_TTL_MS=60000

# ---- Optional: persistence -------------------------------------------------
# Postgres/TimescaleDB connection string. See db/schema.sql and lib/db.ts.
DATABASE_URL=
# Redis cache for snapshot fan-out across API instances.
REDIS_URL=
